# ===========================================
# Application
# ===========================================
# Port the server listens on
PORT=3000

# ===========================================
# Logger
# ===========================================
# Log level: debug | info | warn | error
LOG_LEVEL=info

# ===========================================
# JWT
# ===========================================
# Secret used to sign and verify access tokens (use a long random string)
JWT_ACCESS_TOKEN_SECRET_KEY=change_me_access_secret
# Secret used to sign and verify refresh tokens (must differ from the access token secret)
JWT_REFRESH_TOKEN_SECRET_KEY=change_me_refresh_secret
# Access token lifetime, e.g. 15m, 1h
JWT_ACCESS_TOKEN_TTL=15m
# Refresh token lifetime, e.g. 7d, 30d
JWT_REFRESH_TOKEN_TTL=7d

# ===========================================
# BSC (BNB Smart Chain)
# ===========================================
# RPC endpoint for BSC (mainnet or testnet)
BSC_RPC_URL=https://bsc-dataseed.binance.org
# Address of the token deposit smart contract on BSC
BSC_TOKEN_DEPOSIT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ===========================================
# BASE
# ===========================================
# RPC endpoint for Base (mainnet or Base Sepolia testnet)
BASE_RPC_URL=https://mainnet.base.org
# Address of the token contract on Base
BASE_TOKEN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Private key of the token owner wallet (never commit a real value)
BASE_TOKEN_OWNER_WALLET_PRIVATE_KEY=0xyour_private_key_here

# ===========================================
# PostgreSQL
# ===========================================
# Database credentials and name, used by docker-compose to initialize the PostgreSQL container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=app_db

# ===========================================
# Prisma
# ===========================================
# Database connection string. Must match POSTGRES_* values above.
# Use "localhost" when running the app on the host, and the service name (e.g. "postgres") when running in Docker.
PRISMA_DATABASE_URL=postgresql://postgres:change_me@localhost:5432/app_db